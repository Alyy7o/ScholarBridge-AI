# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never expose). Used by API routes + edge function for privileged ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (tried in order: Gemini → Groq → OpenRouter → offline template) ──
# Free-tier tip: draft ~50–100 professors per sitting; COMPOSE_AI_CONCURRENCY=4 by default.
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.0-flash
GROQ_API_KEY=
GROQ_MODEL=llama-3.3-70b-versatile
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-chat
OPENROUTER_MODEL_FALLBACK=qwen/qwen-2.5-32b-instruct
COMPOSE_AI_CONCURRENCY=4
# Research-only bridge sentence for AI paragraphs (no scholarship/MEXT wording).
# Prefer Settings → Email / AI profile (ai_background). Env is fallback when profile is empty.
# STUDENT_BACKGROUND=As co-author of "NeuroClip: ..." (submitted to FIT 2026), I worked on ...

OPENALEX_MAILTO=you@example.com
OPENALEX_API_KEY=

# ── Google OAuth (for Gmail send) ──
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL (used for OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000

# ── Contact form (Gmail) ──
CONTACT_TO_EMAIL=you@example.com
CONTACT_GMAIL_REFRESH_TOKEN=
CONTACT_FROM_EMAIL=you@example.com
