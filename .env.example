# ── Supabase ──
NEXT_PUBLIC_SUPABASE_URL=https://YOUR-PROJECT.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-anon-key
# Server-only (never expose). Used by API routes + edge function for privileged ops.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key

# ── AI (OpenRouter) ── blank = offline fallback lines
OPENROUTER_API_KEY=
OPENROUTER_MODEL_PRIMARY=deepseek/deepseek-chat
OPENROUTER_MODEL_FALLBACK=qwen/qwen-2.5-32b-instruct
OPENALEX_MAILTO=you@example.com

# ── Google OAuth (for Gmail send) ──
# Same client you configure in Supabase Auth (Google provider).
# Needed here to refresh the Gmail access token when sending.
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=

# Public site URL (used for OAuth redirect)
NEXT_PUBLIC_SITE_URL=http://localhost:3000
